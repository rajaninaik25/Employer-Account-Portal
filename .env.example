# Placeholder environment configuration.
#
# Copy to `.env` for local use only; `.env` is git-ignored and must never be
# committed. No real value belongs in this example file — see
# docs/design/05-implementation-design.md §14 and docs/security/07-security-design.md §12.
# Exact variable names/values remain subject to later Security/Data Model approval.

# --- Portal application (non-secret) ---
PORTAL_APP_MODE=development
PORTAL_ALLOWED_ORIGIN=http://localhost:5173
PORTAL_LOG_LEVEL=info

# --- Local integration mode (non-secret) ---
# fixture = fixture-backed Employer Information Gateway (default, no Salesforce required)
# live = real Salesforce adapter (requires the secrets below)
SALESFORCE_INTEGRATION_MODE=fixture

# --- Salesforce connection (backend-only; secrets excluded from this example) ---
SALESFORCE_ORG_BASE_URL=
SALESFORCE_API_VERSION=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
